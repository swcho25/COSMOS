FROM node:24-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && mkdir -p /opt/nexus/certs \
    && curl -fsSL \
      https://truststore.pki.rds.amazonaws.com/ap-northeast-2/ap-northeast-2-bundle.pem \
      -o /opt/nexus/certs/ap-northeast-2-bundle.pem \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/nexus/app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

COPY lib ./lib
COPY db ./db
COPY scripts ./scripts
COPY config ./config

ENV NODE_ENV=production \
    MYSQL_SSL_CA_PATH=/opt/nexus/certs/ap-northeast-2-bundle.pem

CMD ["node", "--experimental-strip-types", "scripts/crawl-publisher-history-to-mysql.mjs", "--years", "10", "--continuous"]
