{
  "name": "cosmos-risk-intelligence",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node scripts/prune-server-static-assets.mjs",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:news-extractor": "node --experimental-strip-types --test tests/news-article-extractor.test.mjs tests/news-crawler.test.mjs tests/robots-policy.test.mjs tests/news-body-crawler.test.mjs tests/news-repository-body.test.mjs",
    "news:extract:test": "node --experimental-strip-types scripts/test-news-article-extraction.mjs",
    "news:mysql:verify": "node --experimental-strip-types scripts/verify-news-mysql.mjs",
    "news:mysql:sync-production": "node --experimental-strip-types scripts/sync-production-news-to-mysql.mjs",
    "news:mysql:backfill-production": "node --experimental-strip-types scripts/sync-production-news-to-mysql.mjs --backfill",
    "news:mysql:watch-production": "node --experimental-strip-types scripts/sync-production-news-to-mysql.mjs --watch --backfill",
    "news:crawler:standalone": "node --experimental-strip-types scripts/news-crawler-standalone.mjs",
    "news:crawler:hellot-range": "node --experimental-strip-types scripts/crawl-hellot-range-to-mysql.mjs",
    "news:crawler:publishers": "node --experimental-strip-types scripts/crawl-publisher-sitemaps-to-mysql.mjs",
    "news:crawler:naver-discovery": "node --experimental-strip-types scripts/crawl-naver-publisher-discovery-to-mysql.mjs",
    "news:crawler:active-publishers": "node --experimental-strip-types scripts/crawl-active-publisher-sitemaps-to-mysql.mjs",
    "news:crawler:publisher-history": "node --experimental-strip-types scripts/crawl-publisher-history-to-mysql.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern aws-static-*",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@mozilla/readability": "^0.6.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.0",
    "drizzle-orm": "0.45.2",
    "linkedom": "^0.18.13",
    "mysql2": "^3.24.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
