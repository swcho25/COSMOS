{
  "defaults": {
    "enabled": true,
    "strategy": "auto",
    "sitemapUrls": [
      "/sitemap.xml",
      "/sitemap_index.xml",
      "/sitemap-index.xml",
      "/sitemap/sitemap.xml",
      "/news-sitemap.xml"
    ],
    "yearlySitemapTemplates": [
      "/sitemap-{year}.xml",
      "/sitemap_{year}.xml",
      "/sitemap/{year}.xml",
      "/sitemap/{year}/sitemap.xml"
    ],
    "monthlySitemapTemplates": [
      "/sitemap-{year}-{month}.xml",
      "/sitemap_{year}_{month}.xml",
      "/sitemap/{year}/{month}.xml",
      "/news-sitemap-{year}-{month}.xml"
    ],
    "archiveUrls": [],
    "archiveTemplates": []
  },
  "publishers": {
    "hellot.net": {
      "enabled": false,
      "strategy": "separate-id-range",
      "note": "crawl-hellot-range-to-mysql.mjs already performs the historical numeric-ID backfill"
    }
  }
}
