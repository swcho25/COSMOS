DART_API_KEY=
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-password
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=
# NAVER API Hub 대신 기존 Naver Open API를 쓸 때만 openapi로 설정합니다.
NAVER_API_MODE=hub
NEWS_DATABASE_DRIVER=mysql
MYSQL_URL=mysql://nexus:nexus-local-password@127.0.0.1:3306/nexus_risk
# 여러 MySQL에 동시에 저장하려면 쉼표로 구분합니다. 설정 시 MYSQL_URL보다 우선합니다.
MYSQL_URLS=
NEWS_BODY_BATCH_SIZE=100
NEWS_CRAWLER_INTERVAL_SECONDS=300
NEWS_BACKLOG_INTERVAL_SECONDS=30
NAVER_DISCOVERY_INTERVAL_MINUTES=60
NAVER_DISCOVERY_BACKFILL_PAGES=3
GRAPH_ATTENUATION=0.82
NEXT_PUBLIC_SITE_URL=http://localhost:3000
