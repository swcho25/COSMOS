# Keep source and configuration files consistent across Windows and Linux.
.gitattributes text eol=lf
* text=auto

*.java text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.sql text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
gradlew text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# Preserve mixed source line endings and intentional spaces in delivery patches.
AI/graph/service_delivery/*.patch -text -whitespace
